+#!/usr/bin/env bash
+# Cria o primeiro usuario no CRM local, via API de auth do Supabase.
+set -uo pipefail
+cd "C:/Users/PC de Milhões/crm-whatsapp"
+
+ANON=$(grep '^NEXT_PUBLIC_SUPABASE_ANON_KEY=' .env.local | cut -d= -f2-)
+URL=$(grep '^NEXT_PUBLIC_SUPABASE_URL=' .env.local | cut -d= -f2-)
+SERVICE=$(grep '^SUPABASE_SERVICE_ROLE_KEY=' .env.local | cut -d= -f2-)
+
+EMAIL="${1:-vitor@crm.local}"
+SENHA="${2:-}"
+if [ -z "$SENHA" ]; then
+  # Sem senha no argumento: gera uma forte e imprime uma vez.
+  SENHA=$(python -c "import secrets,string; a=string.ascii_letters+string.digits; print(''.join(secrets.choice(a) for _ in range(20))+'!A1')")
+  echo "senha gerada (guarde, nao fica salva): $SENHA"
+fi
+
+echo "criando usuario em $URL ..."
+# admin create: ja nasce confirmado, sem precisar de email
+curl -s -X POST "$URL/auth/v1/admin/users" \
+  -H "Content-Type: application/json" \
+  -H "apikey: $SERVICE" \
+  -H "Authorization: Bearer $SERVICE" \
+  -d "{\"email\":\"$EMAIL\",\"password\":\"$SENHA\",\"email_confirm\":true}" \
+  | head -c 500
+echo
+echo "---"
+echo "email: $EMAIL"
+echo "senha: $SENHA"
