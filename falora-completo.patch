index 00000000..bf46c2a5
--- /dev/null
+++ b/scripts/provar-conserto-crontab.sh
@@ -0,0 +1,90 @@
+#!/usr/bin/env bash
+# Prova que o conserto do #715 funciona, usando as funcoes REAIS do _common.sh
+# deste repositorio (nao uma copia), sob o mesmo `set -euo pipefail` do instalador.
+#
+#   bash scripts/provar-conserto-crontab.sh
+#
+# Esperado: os dois cenarios passam. ANTES do conserto, o CENARIO 1 morria com
+# exit 1 sem gravar nada -- que e exatamente o sintoma da issue #715.
+#
+# Nota de quem escreveu: a primeira versao deste script exportava o PATH do duble
+# na shell de fora e chamava um subshell `( ... )`; o duble nao era encontrado e
+# os dois cenarios falhavam por motivo errado. O PATH precisa ir NA MESMA linha
+# de comando do bash filho, como abaixo.
+
+set -uo pipefail
+
+RAIZ="$(cd "$(dirname "$0")/.." && pwd)"
+falhas=0
+
+roda_cenario() {
+  local titulo="$1" conteudo_inicial="$2"
+  local F; F="$(mktemp -d)"
+
+  cat > "$F/crontab" <<'DUBLE'
+#!/usr/bin/env bash
+# Duble de `crontab`. A escrita e ATOMICA (temp + mv) de proposito: o codigo real
+# faz `( crontab -l | ... ) | crontab -`, e os dois lados do pipe rodam ao mesmo
+# tempo. Um duble que fizesse `cat > "$ARQ"` truncaria o arquivo ANTES de o
+# `crontab -l` da esquerda conseguir le-lo, e o teste acusaria perda de linha que
+# o crontab de verdade nao tem (ele grava num spool temporario e troca no fim).
+ARQ="$(dirname "$0")/conteudo"
+case "$1" in
+  -l) if [ -s "$ARQ" ]; then cat "$ARQ"; exit 0; else echo "no crontab for root" >&2; exit 1; fi ;;
+  -)  TMP="$(mktemp)"; cat > "$TMP"; mv "$TMP" "$ARQ"; exit 0 ;;
+  *)  exit 0 ;;
+esac
+DUBLE
+  chmod +x "$F/crontab"
+  printf '%s' "$conteudo_inicial" > "$F/conteudo"
+
+  echo
+  echo "=== $titulo ==="
+
+  PATH="$F:$PATH" bash -c '
+    set -euo pipefail
+    export INTERNAL_SECRET="segredo-de-teste"
+    export NEXT_PUBLIC_APP_URL="https://exemplo.com.br"
+    export PROJECT_DIR="/root/crm"
+    cd "$1"
+    source hostgator-setup-kit/_common.sh
+    setup_event_log_drain_cron
+    setup_update_agent_cron
+  ' _ "$RAIZ" >/dev/null 2>&1
+  local rc=$?
+
+  if [ "$rc" -eq 0 ]; then
+    echo "  OK    instalador seguiu (exit 0)"
+  else
+    echo "  FALHA instalador morreu (exit $rc)  <-- sintoma do #715"
+    falhas=$((falhas + 1))
+  fi
+
+  if grep -q 'event-log-drain' "$F/conteudo" 2>/dev/null; then
+    echo "  OK    linha do drain gravada no crontab"
+  else
+    echo "  FALHA linha do drain NAO foi gravada"
+    falhas=$((falhas + 1))
+  fi
+
+  if grep -q 'agent.sh' "$F/conteudo" 2>/dev/null; then
+    echo "  OK    linha do agente de atualizacao gravada"
+  else
+    echo "  FALHA linha do agente NAO foi gravada"
+    falhas=$((falhas + 1))
+  fi
+
+  rm -rf "$F"
+}
+
+roda_cenario "CENARIO 1 - VPS nova, usuario nunca teve crontab" ""
+roda_cenario "CENARIO 2 - VPS que ja tinha crontab" "0 3 * * * /outra/coisa
+"
+
+echo
+if [ "$falhas" -eq 0 ]; then
+  echo "TODOS OS CENARIOS PASSARAM"
+else
+  echo "$falhas verificacao(oes) falharam"
+fi
+exit "$falhas"
-- 
