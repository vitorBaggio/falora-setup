+#!/usr/bin/env bash
+# Cria a organizacao e torna o usuario local dono/admin dela.
+#
+# Replica o bloco 8 do hostgator-setup-kit/install.sh (linhas ~1955-2035), que
+# e o passo que o instalador faz e que a nossa configuracao manual pulou.
+# Sem ele o usuario existe no Auth mas nao pertence a organizacao nenhuma:
+# o menu aparece vazio, porque toda tela e filtrada por organizacao (RLS).
+set -uo pipefail
+cd "C:/Users/PC de Milhões/crm-whatsapp"
+
+TOKEN="${1:-}"
+REF="${2:-lrfyblkgotaaetuzxoks}"
+EMAIL="${3:-vitor@crm.local}"
+[ -n "$TOKEN" ] || { echo "uso: $0 <sbp_token> [ref] [email]"; exit 1; }
+
+SQL=$(cat <<SQLEOF
+do \$\$
+declare v_org uuid; v_uid uuid;
+begin
+  select id into v_uid from auth.users where email = '${EMAIL}';
+  if v_uid is null then
+    raise exception 'usuario % nao encontrado em auth.users', '${EMAIL}';
+  end if;
+
+  select id into v_org from public.organizations where slug='minha-empresa';
+  if v_org is null then
+    insert into public.organizations (slug, display_name, legal_name, locale, created_by)
+    values ('minha-empresa','Minha Empresa','Minha Empresa','pt-BR', v_uid)
+    returning id into v_org;
+  end if;
+
+  insert into public.user_organizations (user_id, organization_id, role, accepted_at)
+  values (v_uid, v_org, 'admin', now())
+  on conflict (user_id, organization_id) do update set role='admin', revoked_at=null;
+
+  if not exists (select 1 from public.platform_admins where user_id=v_uid and revoked_at is null) then
+    -- mfa_required=false EXPLICITO: o default da coluna e true e faria o dono
+    -- cair num bloqueador de tela cheia logo depois do onboarding.
+    insert into public.platform_admins (user_id, granted_by, scope, mfa_required, reason)
+    values (v_uid, v_uid, 'full', false, 'Bootstrap local');
+  end if;
+end \$\$;
+SQLEOF
+)
+
+# monta o JSON com python para escapar corretamente
+PAYLOAD=$(SQL="$SQL" python -c 'import json,os;print(json.dumps({"query":os.environ["SQL"]}))')
+
+echo "aplicando no projeto $REF ..."
+curl -s -X POST \
+  -H "Authorization: Bearer $TOKEN" \
+  -H "Content-Type: application/json" \
+  -d "$PAYLOAD" \
+  "https://api.supabase.com/v1/projects/$REF/database/query" | head -c 300
+echo
+echo "--- conferindo ---"
+CONF=$(python -c 'import json;print(json.dumps({"query":"select u.email, o.display_name, uo.role, (pa.user_id is not null) as platform_admin from auth.users u join public.user_organizations uo on uo.user_id=u.id join public.organizations o on o.id=uo.organization_id left join public.platform_admins pa on pa.user_id=u.id and pa.revoked_at is null"}))')
+curl -s -X POST \
+  -H "Authorization: Bearer $TOKEN" \
+  -H "Content-Type: application/json" \
+  -d "$CONF" \
+  "https://api.supabase.com/v1/projects/$REF/database/query"
+echo
