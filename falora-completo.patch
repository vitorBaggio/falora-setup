 hostgator-setup-kit/_common.sh     | 14 ++++-
 scripts/provar-conserto-crontab.sh | 90 ++++++++++++++++++++++++++++++
 2 files changed, 101 insertions(+), 3 deletions(-)
 create mode 100644 scripts/provar-conserto-crontab.sh

