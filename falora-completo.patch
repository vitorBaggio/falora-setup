+#!/usr/bin/env python3
+"""
+Configura o CRM local inteiro a partir de UM token do Supabase.
+
+Uso:
+    python scripts/configurar-local.py sbp_SEU_TOKEN_AQUI
+
+O que ele faz sozinho:
+  1. Lista seus projetos e acha o chamado "CRM"
+  2. Pega a URL e as chaves (publishable e secret) pela API de gerenciamento
+  3. Aplica o schema (supabase/baseline.sql) rodando SQL pela API,
+     o que dispensa a senha do banco
+  4. Escreve o .env.local preenchido
+
+O token NAO e gravado em disco: e lido do argumento e some com o processo.
+"""
+import json
+import sys
+import urllib.error
+import urllib.request
+from pathlib import Path
+
+API = "https://api.supabase.com"
+RAIZ = Path(__file__).resolve().parent.parent
+
+
+def chamar(caminho, token, metodo="GET", corpo=None):
+    dados = json.dumps(corpo).encode() if corpo is not None else None
+    req = urllib.request.Request(
+        API + caminho,
+        data=dados,
+        method=metodo,
+        headers={
+            "Authorization": f"Bearer {token}",
+            "Content-Type": "application/json",
+            "User-Agent": "configurar-local",
+        },
+    )
+    try:
+        with urllib.request.urlopen(req, timeout=120) as r:
+            txt = r.read().decode()
+            return json.loads(txt) if txt.strip() else None
+    except urllib.error.HTTPError as e:
+        detalhe = e.read().decode()[:400]
+        raise SystemExit(f"ERRO {e.code} em {metodo} {caminho}\n{detalhe}")
+
+
+def main():
+    if len(sys.argv) < 2 or not sys.argv[1].startswith("sbp_"):
+        raise SystemExit(
+            "Falta o token.\n"
+            "Pegue em https://supabase.com/dashboard/account/tokens\n"
+            "Uso: python scripts/configurar-local.py sbp_..."
+        )
+    token = sys.argv[1].strip()
+
+    print("[1/4] procurando seus projetos...")
+    projetos = chamar("/v1/projects", token)
+    if not projetos:
+        raise SystemExit("Nenhum projeto na conta.")
+
+    for p in projetos:
+        print(f"      - {p['name']}  ({p['id']}, {p.get('region')})")
+
+    alvo = None
+    # 1) se veio ref na linha de comando, usa ele
+    if len(sys.argv) > 2:
+        pedido = sys.argv[2].strip()
+        alvo = next((p for p in projetos if p["id"] == pedido or p["name"] == pedido), None)
+        if alvo is None:
+            raise SystemExit(f"Projeto '{pedido}' nao encontrado.")
+    # 2) senao, o unico ACTIVE_HEALTHY
+    if alvo is None:
+        ativos = [p for p in projetos if p.get("status") == "ACTIVE_HEALTHY"]
+        if len(ativos) == 1:
+            alvo = ativos[0]
+            print(f"      unico projeto ativo: {alvo['name']}")
+        elif not ativos:
+            raise SystemExit("Nenhum projeto ativo. Ligue um no painel e rode de novo.")
+        else:
+            nomes = ", ".join(f"{p['name']} ({p['id']})" for p in ativos)
+            raise SystemExit(f"Varios ativos, escolha um: {nomes}\nUso: ... TOKEN <ref>")
+    ref = alvo["id"]
+    print(f"      escolhido: {alvo['name']} ({ref}, {alvo.get('region')})")
+
+    print("[2/4] pegando as chaves...")
+    chaves = chamar(f"/v1/projects/{ref}/api-keys", token)
+    publicavel = secreta = None
+    for k in chaves or []:
+        nome = (k.get("name") or "").lower()
+        tipo = (k.get("type") or "").lower()
+        valor = k.get("api_key") or ""
+        if valor.startswith("sb_publishable_") or nome == "anon":
+            publicavel = publicavel or valor
+        elif valor.startswith("sb_secret_") or nome == "service_role":
+            secreta = secreta or valor
+        elif tipo == "publishable":
+            publicavel = publicavel or valor
+        elif tipo == "secret":
+            secreta = secreta or valor
+
+    if not publicavel or not secreta:
+        raise SystemExit(f"Nao achei as duas chaves. Recebido: {json.dumps(chaves)[:500]}")
+    print(f"      publicavel: {publicavel[:22]}...")
+    print(f"      secreta:    {secreta[:18]}... (nao sera exibida inteira)")
+
+    print("[3/4] aplicando o schema (pode levar 1-2 min)...")
+    sql = (RAIZ / "supabase" / "baseline.sql").read_text(encoding="utf-8")
+    print(f"      baseline.sql: {len(sql.splitlines())} linhas")
+    chamar(f"/v1/projects/{ref}/database/query", token, "POST", {"query": sql})
+    print("      schema aplicado")
+
+    conferencia = chamar(
+        f"/v1/projects/{ref}/database/query",
+        token,
+        "POST",
+        {"query": "select count(*)::int as n from information_schema.tables "
+                  "where table_schema='public' and table_type='BASE TABLE'"},
+    )
+    print(f"      tabelas no banco: {conferencia}")
+
+    print("[4/4] escrevendo .env.local...")
+    env = f"""# Gerado por scripts/configurar-local.py. SO PARA DESENVOLVIMENTO.
+# Este arquivo NUNCA vai para o GitHub (.gitignore cobre .env*).
+
+NEXT_PUBLIC_SUPABASE_URL=https://{ref}.supabase.co
+NEXT_PUBLIC_SUPABASE_ANON_KEY={publicavel}
+SUPABASE_SERVICE_ROLE_KEY={secreta}
+
+NEXT_PUBLIC_APP_URL=http://localhost:3000
+INTERNAL_SECRET=chave-local-de-desenvolvimento-nao-usar-em-producao
+
+# WhatsApp vazio de proposito: conectar numero exige endereco publico.
+WAHA_API_BASE_URL=
+WAHA_API_KEY=
+SENTRY_DSN=off
+"""
+    (RAIZ / ".env.local").write_text(env, encoding="utf-8", newline="\n")
+    print("      .env.local escrito")
+
+    print()
+    print("PRONTO. Agora: pnpm dev  e abra http://localhost:3000")
+
+
+if __name__ == "__main__":
+    main()
